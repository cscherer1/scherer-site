# Public profile / contact configuration.
#
# Every value is optional. Defaults live in src/config/profile.ts and are the
# current live values. Set any of these in Vercel (or a local .env) to change
# the site without touching source.

# Identity
VITE_PROFILE_NAME=Christian Scherer
VITE_CONTACT_EMAIL=cschere1@gmail.com

# Where he lives now, and any relocation he is open to (leave empty to hide).
VITE_CONTACT_LOCATION=Las Vegas, NV
VITE_RELOCATION_TARGET=Brighton / Greater London, UK (potential)
VITE_CITIZENSHIP=US/UK dual citizen
VITE_SPONSORSHIP_NOTE=no UK sponsorship needed

# Phones: a JSON array of {label, number}.
VITE_CONTACT_PHONES=[{"label":"US Phone","number":"+1 (910) 333-7347"},{"label":"UK Phone","number":"+44 7522 346480"}]

# Links shown in the footer: a JSON array of {label, href}.
VITE_CONTACT_LINKS=[{"label":"GitHub","href":"https://github.com/cscherer1"},{"label":"LinkedIn","href":"https://www.linkedin.com/in/cschere1"}]

# Contact copy
VITE_AVAILABILITY=Open to in-office, hybrid, or remote full-time or contract roles in integration architecture, automation architecture and solutions engineering.
VITE_CONTACT_NOTE=Email is the best first contact.

# Resume asset in public/ and its cache-busting token.
VITE_RESUME_FILE=Christian_Scherer_Resume.pdf
VITE_RESUME_BUST=

# API base for the projects page.
VITE_API_URL=https://scherer-api.onrender.com
